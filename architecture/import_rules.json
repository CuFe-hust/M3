{
  "description": "Import dependency rules for the new top-level packages. 新顶层包导入依赖规则。",
  "internal_packages": [
    "application",
    "data",
    "models",
    "agents",
    "routing",
    "workflows",
    "evaluation",
    "reporting"
  ],
  "packages": {
    "data": {
      "allow": ["data"]
    },
    "models": {
      "allow": ["models"]
    },
    "agents": {
      "allow": ["agents", "data.schema", "models"]
    },
    "routing": {
      "allow": ["routing", "data.schema", "agents.schema"]
    },
    "evaluation": {
      "allow": [
        "evaluation",
        "data.schema",
        "agents.schema",
        "agents.counting.schema",
        "models.base",
        "models.cache",
        "models.settings"
      ]
    },
    "reporting": {
      "allow": [
        "reporting",
        "data.schema",
        "agents.schema",
        "agents.counting.schema",
        "agents.change.schema",
        "routing.schema",
        "workflows.schema",
        "evaluation"
      ]
    },
    "workflows": {
      "allow": [
        "workflows",
        "data",
        "agents",
        "routing",
        "evaluation",
        "models"
      ]
    },
    "application": {
      "allow": [
        "application",
        "data",
        "models",
        "agents",
        "routing",
        "workflows",
        "evaluation",
        "reporting"
      ]
    },
    "main": {
      "allow": ["application"]
    }
  },
  "forbidden_patterns": {
    "reporting": [
      "agents.*.agent",
      "models.qwen_transformers",
      "workflows.sample_runner"
    ],
    "evaluation": ["application"],
    "agents": ["application", "workflows"],
    "models": ["data"],
    "routing": ["models", "data.adapters"]
  }
}
