{
  "description": "Import dependency rules for the new top-level packages. 新顶层包导入依赖规则。",
  "internal_packages": [
    "application",
    "data",
    "models",
    "agents",
    "routing",
    "workflows",
    "evaluation",
    "reporting",
    "spacers_agent",
    "eval"
  ],
  "packages": {
    "data": {
      "allow": ["data"]
    },
    "models": {
      "allow": ["models"]
    },
    "agents": {
      "allow": ["agents", "data", "models"]
    },
    "routing": {
      "allow": ["routing", "data.schema", "agents.schema"]
    },
    "evaluation": {
      "allow": ["evaluation", "data", "agents.schema", "models"]
    },
    "reporting": {
      "allow": ["reporting", "data", "agents.schema", "evaluation"]
    },
    "workflows": {
      "allow": ["workflows", "data", "agents", "routing", "evaluation", "models"]
    },
    "application": {
      "allow": [
        "application",
        "data",
        "models",
        "agents",
        "routing",
        "workflows",
        "evaluation",
        "reporting"
      ]
    },
    "main": {
      "allow": ["application"]
    }
  },
  "final_mode_env": "M3_ARCH_FINAL",
  "legacy_packages": ["spacers_agent", "eval"]
}
