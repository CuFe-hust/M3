{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M3-RS metric record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_schema_version", "run_id", "metric_id", "availability", "provenance", "value_canonical", "n_samples", "n_failures", "recorded_at", "protocol_id", "benchmark_version"],
  "properties": {
    "record_schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "metric_id": {"type": "string", "minLength": 1},
    "availability": {"enum": ["available", "missing", "not_applicable", "failed"]},
    "provenance": {"enum": ["official", "supplemental"]},
    "value_canonical": {"type": ["number", "null"]},
    "n_samples": {"type": "integer", "minimum": 0},
    "n_failures": {"type": "integer", "minimum": 0},
    "recorded_at": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string", "minLength": 1},
    "dataset": {"type": ["string", "null"], "minLength": 1},
    "task": {"type": ["string", "null"], "minLength": 1},
    "slice": {"type": ["string", "null"], "minLength": 1},
    "language": {"type": ["string", "null"], "minLength": 1},
    "ci95_low": {"type": "number"},
    "ci95_high": {"type": "number"},
    "source_log_path": {"type": ["string", "null"], "minLength": 1},
    "notes": {"type": ["string", "null"], "minLength": 1},
    "baseline_run_id": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {"dependentRequired": {"ci95_low": ["ci95_high"], "ci95_high": ["ci95_low"]}},
    {
      "if": {"properties": {"availability": {"const": "available"}}},
      "then": {"properties": {"value_canonical": {"type": "number"}, "n_samples": {"minimum": 1}}},
      "else": {
        "properties": {"value_canonical": {"type": "null"}},
        "not": {"anyOf": [{"required": ["ci95_low"]}, {"required": ["ci95_high"]}]}
      }
    }
  ],
  "x-m3rs-relations": [
    {"rule": "all_or_none", "fields": ["ci95_low", "ci95_high"]},
    {"rule": "less_than_or_equal", "left": "ci95_low", "right": "ci95_high"},
    {"rule": "less_than_or_equal", "left": "n_failures", "right": "n_samples"},
    {"rule": "run_relative_path", "field": "source_log_path"}
  ]
}
